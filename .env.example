# Production environment variables.
# In Vercel: Project Settings -> Environment Variables (Production + Preview).
# For local runs: copy to `.env` and export, or set them in your shell.

# Hosted Postgres connection string (Neon, Supabase, Vercel Postgres, ...).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret used to sign admin session tokens. Use a long random string.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Vercel Blob read/write token (Vercel -> Storage -> Blob).
# Needed so uploaded product images persist. Without it, uploads are written to
# local disk (works locally, but not on Vercel).
BLOB_READ_WRITE_TOKEN=

# Optional: enable real Clerk authentication. When these are unset, the site
# uses the built-in username/password admin login instead.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
